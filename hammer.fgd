@SolidClass = worldspawn : "World entity"
[
	message(string) : "Intro message"
]

@SolidClass = reverb_zone : "Reverb Zone"
[
	reverb(choices) : "Reverb Type" : 0 =
	[
		0 : "Generic"
		1 : "Hallway"
		2 : "Room"
		3 : "Large Room"
		4 : "Stairwell"
	]
]

@BaseClass = Angles
[
	angles(string) : "Pitch(X) Yaw(Y) Roll(Z)" : "0 0 0"
]

@BaseClass = Parent
[
	child(string) : "Child Entity Identifier"
]

@BaseClass = Targetable
[
	identifier(string) : "Unique Identifier" : ""
]

@BaseClass = Trigger
[
	target(string) : "Target Entity Identifier"
	triggertype(choices) : "Trigger Type" : 0 =
	[
		0 : "Toggle"
		1 : "On"
		2 : "Off"
	]
]

@BaseClass = Usable
[
	usetxt(string) : "Use Text" : "Use"
]

@BaseClass size(-12 -12 -29, 12 12 29) color(0 255 0) = PlayerClass []
@BaseClass size(-16 -16 0, 16 16 32) color(0 0 255) = MeshClass []
@BaseClass size(-8 -8 0, 8 8 32) color(255 0 0) = DynamicClass []

@PointClass color(255 255 255) = light : "Light" [
	color(color255) : "Color" : "255 255 255 255"
	intensity(integer) : "Intensity" : 1
]

@PointClass base(PlayerClass, Angles) = info_player_start : "Player Start" []
@PointClass base(MeshClass, Angles) = info_static_mesh : "Static Mesh"
[
	mesh(string) : "Filename of the mesh"
]

@PointClass base(DynamicClass, Angles) = prop_physics_mesh : "Physics Mesh"
[
	mesh(string) : "Filename of the mesh"
	spawnflags(flags) = 
	[
		1 : "Dynamic" : 0
	]
]

@PointClass base(Angles) = prop_door : "Door"
[
	model(choices) : "Model" : 1 =
	[
		0 : "NULL"
		1 : "Industrial Door (Left)"
		2 : "Industrial Door (Right)"
	]
	speed(integer) : "Open/Close speed" : 2
	direction(choices) : "Open Direction" : 0 =
	[
		0 : "Counter-Clockwise"
		1 : "Clockwise"
	]
]

@SolidClass base(Targetable) = door_elevator : "Elevator Door"
[
	direction(choices) : "Open Direction" : 0 =
	[
		0 : "+X"
		1 : "-X"
		2 : "+Z"
		3 : "-Z"
	]
	distmult(string) : "Move Distance Multiplier" : "1"
]

@SolidClass base(Targetable, Parent) = elevator : "Elevator"
[
	travel(string) : "Travel Delta" : "0 0 0"
	speed(string) : "Movement Speed" : "1"
	firstdoor(string) : "First Door Entity Identifier"
	seconddoor(string) : "Second Door Entity Identifier"
]

@SolidClass base(Targetable, Trigger, Usable, Parent) = button : "Button" []